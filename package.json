{
  "name": "lumio-browser",
  "productName": "Lumio Browser",
  "version": "0.5.0",
  "description": "Lumio Browser \u2014 a Chromium web browser with an AI that can read, act and control your computer.",
  "homepage": "https://lumio-browser.gw607953.workers.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/juaniRD23/lumio-browser.git"
  },
  "main": "main/main.js",
  "private": true,
  "scripts": {
    "start": "node scripts/build-preload.mjs && electron .",
    "dev": "node scripts/build-preload.mjs && electron . --remote-debugging-port=9333",
    "native": "sh native/build.sh",
    "icon": "electron build/make-icon.cjs",
    "test": "node --test tests/*.test.mjs server/test/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.e2e.mjs",
    "build:app": "sh native/build.sh && node scripts/build-preload.mjs && node build/package.mjs",
    "install:app": "sh native/build.sh && node scripts/build-preload.mjs && node build/package.mjs --install",
    "release": "node scripts/build-preload.mjs && node build/package.mjs --release"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "electron-chrome-extensions": "^4.9.0",
    "electron-chrome-web-store": "^0.13.0",
    "marked": "^16.1.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.2",
    "electron": "43.0.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.55.0"
  },
  "license": "GPL-3.0-or-later"
}
