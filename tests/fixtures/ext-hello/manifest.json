{
  "manifest_version": 3,
  "name": "Lumio Test Extension",
  "version": "1.0.0",
  "description": "Marks pages it runs on, answers messages from its background worker, and has a toolbar popup.",
  "icons": { "32": "icon.png" },
  "action": { "default_popup": "popup.html", "default_icon": { "32": "icon.png" }, "default_title": "Lumio Test" },
  "background": { "service_worker": "sw.js" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"] }],
  "permissions": ["tabs", "storage"],
  "options_page": "options.html"
}
